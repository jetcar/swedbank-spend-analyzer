POSTGRES_DB=spend_analyzer
POSTGRES_USER=spend_analyzer
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://spend_analyzer:change-me@postgres:5432/spend_analyzer

# Add after registering an Enable Banking application.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=/run/secrets/enablebanking_private_key

# Optional separate sandbox credentials for Demo. Without them the main app
# credentials are accepted ONLY if GET /application confirms SANDBOX.
DEMO_ENABLE_BANKING_APP_ID=
DEMO_ENABLE_BANKING_PRIVATE_KEY_PATH=/run/secrets/enablebanking_demo_private_key
# Set to a separate sandbox PEM when using a separate sandbox application id.
DEMO_BANK_KEY_FILE=./secrets/enablebanking.pem
DEMO_BANK_NAME=Swedbank
DEMO_BANK_COUNTRY=EE

# Background bank fetches are limited to four per day by many banks.
AUTO_SYNC_ENABLED=0
AUTO_SYNC_INTERVAL_SECONDS=21600

# Passi OIDC. Keep disabled for local development; production enables it.
PASSI_AUTH_ENABLED=0
PASSI_CLIENT_ID=
PASSI_SESSION_SECRET=
# Local MCP fallback only. Production uses Passi OAuth access tokens.
MCP_CLIENT_TOKEN=local-development-mcp-token
PASSI_RESOURCE=https://finance.passi.cloud/mcp
PASSI_REDIRECT_URI=https://finance.passi.cloud/auth/callback
PASSI_TOKEN_ENDPOINT=https://passi.cloud/openidc/connect/token
PASSI_JWKS_ENDPOINT=https://passi.cloud/openidc/.well-known/jwks
PASSI_EGRESS_BASE_URL=http://bank-egress:8080
