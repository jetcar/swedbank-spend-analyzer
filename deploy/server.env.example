# Save as /opt/finance/.env.server (chmod 600). Start with --env-file .env.server.
APP_IMAGE=jetcar/bank-app:latest
NGINX_IMAGE=jetcar/bank-nginx:latest
POSTGRES_IMAGE=jetcar/bank-postgres:latest
FINANCE_PORT=18000
PROXY_NETWORK=passi_haproxy_net
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=replace-with-random-password
DATABASE_URL=postgresql+asyncpg://finance:replace-with-random-password@postgres:5432/finance
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=/run/secrets/enablebanking_private_key
ENABLE_BANKING_REDIRECT_URL=https://finance.passi.cloud/callback
# Demo may reuse the main credentials only if the application is SANDBOX.
DEMO_ENABLE_BANKING_APP_ID=
DEMO_ENABLE_BANKING_PRIVATE_KEY_PATH=/run/secrets/enablebanking_demo_private_key
DEMO_BANK_KEY_FILE=./secrets/enablebanking.pem
DEMO_BANK_NAME=Swedbank
DEMO_BANK_COUNTRY=EE

AUTO_SYNC_ENABLED=1
AUTO_SYNC_INTERVAL_SECONDS=21600
PASSI_AUTH_ENABLED=1
PASSI_CLIENT_ID=pc_khJtlbjwF-v-wtaz-_gYWFOi
PASSI_CLIENT_SECRET=
PASSI_ALLOWED_EMAILS=admin@passi.cloud
PASSI_SESSION_SECRET=replace-with-independent-random-secret
PASSI_LEGACY_OWNER_ID=admin@passi.cloud
PASSI_RESOURCE=https://finance.passi.cloud/mcp
PASSI_REDIRECT_URI=https://finance.passi.cloud/auth/callback
PASSI_TOKEN_ENDPOINT=https://passi.cloud/openidc/connect/token
PASSI_JWKS_ENDPOINT=https://passi.cloud/openidc/.well-known/jwks
PASSI_EGRESS_BASE_URL=http://bank-egress:8080
